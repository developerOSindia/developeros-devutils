# DeveloperOS Streamlit Suite Configuration Template
# Copy this file to .env.local for local overrides. NEVER commit secrets to git!

# Suite Environment Mode: development | staging | production
DEVOS_ENV=development

# Optional Analytics / Telemetry Opt-out (Default: 1 = fully disabled)
DEVOS_DISABLE_TELEMETRY=1

# Optional Port Override (Default: 8501)
STREAMLIT_SERVER_PORT=8501

# Input Payload Safety Limits (Default: 1MB = 1048576 bytes)
DEVOS_MAX_INPUT_BYTES=1048576
